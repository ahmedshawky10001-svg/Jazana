{# ############## Shared Variables in all views ################
| Variable                                           | Type     | Description                                                                                              |
|----------------------------------------------------|----------|----------------------------------------------------------------------------------------------------------|
| store                                              | Store    |                                                                                                          |
| store.id                                           | int      |                                                                                                          |
| store.name                                         | string   |                                                                                                          |
| store.username                                     | string   |                                                                                                          |
| store.description                                  | string   |                                                                                                          |
| store.slogan                                       | ?string  | * if feature in twilight.json                                                                            |
| store.logo                                         | string   |                                                                                                          |
| store.url                                          | string   |                                                                                                          |
| store.api                                          | string   | the api url for current store                                                                            |
| store.icon                                         | string   | *fav icon url                                                                                            |
| store.contacts                                     | object   | [mobile, phone, email, whatsapp, telegram], ex. store.contacts.email                                     |
| store.social                                       | object   | [instagram, snapchat, twitter, youtube, facebook, pinterest, maroof, whatsapp], ex. store.social.twitter |
| store.settings                                     | object   |                                                                                                          |
| store.settings.auth.email_allowed                  | bool     |                                                                                                          |
| store.settings.auth.mobile_allowed                 | bool     |                                                                                                          |
| store.settings.auth.is_email_required              | bool     |                                                                                                          |
| store.settings.cart.apply_coupon_enabled           | bool     | Does visitor allowed to applay coupon in cart page                                                       |
| store.settings.product.total_sold_enabled          | bool     |                                                                                                          |
| store.settings.product.fit_type                    | ?string  | null when equal product card size is off, or ['cover', 'contain']                                        |
| store.settings.category.testimonial_enabled        | bool     | Show random testimonials in category page                                                                |
| store.settings.tax.number                          | ?string  |                                                                                                          |
| store.settings.tax.certificate                     | ?string  | certificate image url                                                                                    |
| store.settings.tax.taxable_prices_enabled          | bool     | Does tax included in the prices ex product_price 100 & tax is 15, price will be 115                      |
| store.settings.rating_enabled                      | bool     | Is one of: store_enabled or shipping_enabled or products_enabled                                         |
| store.settings.arabic_numbers_enabled              | bool     | Does the merchant wants the numbers to be shown as Arabic format                                         |
| store.settings.is_multilingual                     | bool     |                                                                                                          |
| store.settings.currencies_enabled                  | bool     |     
| theme                                              | Theme    |                                                                                                          |
| theme.id                                           | int      |                                                                                                          |
| theme.name                                         | string   |                                                                                                          |
| theme.mode                                         | string   | `live`, `preview`                                                                                        |
| theme.is_rtl                                       | bool     |                                                                                                          |
| theme.translations_hash                            | int      | to be used in case merchant updated frontend store translations                                          |
| theme.color                                        | object   |                                                                                                          |
| theme.color.primary                                | string   |                                                                                                          |
| theme.color.text                                   | string   | suitable text color comparing to `theme.primary.color`, #000000, #FFFFFF                                 |
| theme.color.reverse_primary                        | string   |                                                                                                          |
| theme.color.reverse_text                           | string   | if `theme.text_color=#000000` means that `theme.reverse_text_color=#FFFFFF`                              |
| theme.color.is_dark                                | bool     | Does main store color `theme.primary.color` considered as dim color?                                     |
| theme.color.darker(float alpha, ?string hexColor)  | string   | get darker color from `theme.primary.color` or from passed color, `alpha` range from 0.0-1.0             |
| theme.color.lighter(float alpha, ?string hexColor) | string   | get lighter color from `theme.primary.color` or from passed color, `alpha` range from 0.0-1.0            |
| theme.font                                         | ?object  | Salla predefined font, null when the theme doesn't have `fonts` feature                                  |
| theme.font.name                                    | string   | DINNextLTArabic-Regular, Amazon-Ember, Apple, Dubai, Estedad                                             |
| theme.font.url                                     | string   | css full url ex: 'https://my_store.test/dist/fonts/default.css'                                          |
| theme.settings                                     | object   | dynamic object with values of the `settings` in twilight.json ex. `theme.settings.topnav_is_dark`        |
| theme.settings.set(settingName, value)             | string   | set global var, then get it {{theme.settings.get('my_var','fallback') }}                                 |
| theme.settings.get(settingName, default=null)      | mixed    | get theme setting ex `theme.settings.get('my_var', 'fallback')`                                          |
#}
<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<!-- بسم الله الرحمن الرحيم -->
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ theme.settings.set('placeholder', 'images/placeholder.png') }}

    <script defer data-cfasync="false" crossorigin="anonymous" src="{{ 'product-card.js'|asset }}"></script>
    <script defer src="{{ 'main-menu.js'|asset }}"></script>
    {% if theme.settings.get('enable_add_product_toast', true) %}
        <script defer src="{{ 'add-product-toast.js'|asset }}"></script>
    {% endif %}

    {% block head_scripts %}{% endblock %}


    <script data-cfasync="false">
        window.header_is_sticky = "{{theme.settings.get('header_is_sticky', 'Default Value')}}"
        window.imageZoom = "{{theme.settings.get('imageZoom')}}"
        window.can_access_wallet = {{ user.can_access_wallet | json_encode }}
        window.enable_more_menu = "{{ theme.settings.get('enable_more_menu', true) }}"
        window.enable_add_product_toast = "{{ theme.settings.get('enable_add_product_toast', true) }}"
        window.notify_when_available_in_card = "{{ theme.settings.get('notify_when_available_in_card', true) }}"
    </script>
    
    {% hook 'head:start' %}
    {% hook head %}
    {% block styles %}{% endblock %}
    <link rel="stylesheet" href="{{ 'app.css' | asset }}">
    <link rel="stylesheet" href="{{ theme.font.path|cdn }}"/>
    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}"/>

    {# ===== Jazana: الخطوط + أيقونات Font Awesome ===== #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Reem+Kufi:wght@500;700&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <style>
        :root {
            --font-main: '{{theme.font.name}}';
            --color-primary: {{ theme.color.primary }};
            --color-primary-dark: {{ theme.color.darker(0.15) }};
            --color-primary-light: {{ theme.color.lighter(0.15) }};
            --color-primary-reverse: {{ theme.color.reverse_text }};
            /* Theme specific variables */
            --s-radius: .75rem;
        }
    </style>
    <style id="jazana-css">
/* ============ Jazana CSS ============ */
:root{
  --color-primary:#5d3e16;--color-primary-dark:#4a3010;--color-primary-light:#7a5322;--color-primary-reverse:#ffffff;
  --font-main:'IBM Plex Sans Arabic',sans-serif;
  --jz-br:#5d3e16;--jz-br2:#4a3010;--jz-gd:#c9a24a;--jz-cr:#fdf6f1;--jz-bd:#eadfd2;--jz-tx:#3b2a12;--jz-mt:#8a7a66;
  --jz-ease:cubic-bezier(.22,.8,.3,1);
}
body{background:linear-gradient(#fff,var(--jz-cr));color:var(--jz-tx);-webkit-font-smoothing:antialiased}
h1,h2,h3,.jz-logo{font-family:'Reem Kufi','IBM Plex Sans Arabic',sans-serif;letter-spacing:0}

/* ---- الشريط العلوي ---- */
body .jz-header .jz-top{background:#f3e3cc!important;color:var(--jz-tx)!important;font-size:12px;padding:6px 0;min-height:0}
.jz-top .container{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;row-gap:2px}
.jz-top b{color:var(--jz-br)}
.jz-top a{color:inherit}
.jz-top i{font-size:12px;margin-inline-end:4px;color:var(--jz-br)}
.jz-top salla-localization-modal{color:inherit}
.jz-top__c{display:flex;align-items:center;gap:8px;white-space:nowrap}

/* ---- الصف الرئيسي ---- */
.jz-header .jz-main{background:#fff;border-bottom:1px solid var(--jz-bd);box-shadow:none!important;min-height:0}
.jz-header .jz-main .inner{background:#fff}
.jz-row{display:flex;align-items:center;gap:20px;padding:12px 0}
.jz-logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:26px;line-height:1.2;color:var(--jz-br);white-space:nowrap}
.jz-logo__name{color:var(--jz-br)}
.jz-header .jz-logo img{width:52px;height:52px;object-fit:contain}
.jz-mb{font-size:20px;color:var(--jz-br);padding:8px}
.jz-mb i{color:var(--jz-br)}

/* البحث */
.jz-sr{flex:1;max-width:560px;margin-inline:auto;min-width:0}
.jz-sr salla-search{display:block;width:100%}
.jz-header .jz-sr .s-search-input{border:1px solid var(--jz-bd)!important;border-radius:8px!important;background:#fffdfb!important;box-shadow:none!important;color:var(--jz-tx);height:44px}
.jz-header .jz-sr .s-search-input:focus{border-color:var(--jz-br)!important}
.jz-sr [class*="search-icon"],.jz-sr [class*="search-icon"] i{color:var(--jz-br)}

/* المفضلة / الحساب / السلة */
.jz-ac{display:flex;gap:16px;align-items:center;font-size:13px;margin-inline-start:auto}
.jz-it{display:flex;gap:6px;align-items:center;color:var(--jz-tx);transition:.25s var(--jz-ease)}
.jz-it i{font-size:18px;color:var(--jz-br)}
.jz-it:hover{color:var(--jz-gd);transform:translateY(-2px)}
.jz-header .header-btn__icon{background:transparent!important;color:var(--jz-br);width:auto;height:auto;font-size:18px}
.jz-header button.s-user-menu-login-btn{background:none!important;color:var(--jz-tx)!important;box-shadow:none;padding:0}
.jz-header .s-user-menu-login-btn svg{fill:var(--jz-br)}
.jz-header .jz-cart{background:var(--jz-br);color:#fff;border-radius:8px;padding:6px 14px;font-weight:700;display:flex;align-items:center;margin:0!important;transition:.25s var(--jz-ease)}
.jz-cart *{color:#fff}
.jz-header .jz-cart .header-btn__icon{color:#fff!important;font-size:15px}
.jz-cart .s-cart-summary-count{position:static!important;background:var(--jz-gd)!important;color:var(--jz-tx)!important;border:0!important;border-radius:10px;padding:0 7px;font-size:12px;width:auto;height:auto;min-width:0}

/* ---- شريط القائمة ---- */
.jz-nav{background:#fff;border-bottom:1px solid var(--jz-bd);font-size:13px}
.jz-nav>.container{display:flex;align-items:center;gap:26px}
.jz-nav__row{flex:1;min-width:0;position:relative}
.jz-live{color:var(--jz-mt);white-space:nowrap;margin-inline-start:auto}
.jz-live:before{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;background:#6bd29b;margin-inline-end:6px}
@media(min-width:1024px){
  .jz-nav .main-menu{margin:0;padding:0;gap:26px;flex-wrap:nowrap}
  .jz-nav .main-menu li>a{padding:10px 0;font-size:13px;color:var(--jz-tx);white-space:nowrap}
  .jz-nav .main-menu li.root-level>a{font-weight:500;padding:10px 0;border-bottom:2px solid transparent}
  .jz-nav .main-menu li.root-level:hover>a{color:var(--jz-gd);border-bottom-color:var(--jz-br)}
  .jz-nav .main-menu .sub-menu{top:100%;border-radius:0 0 8px 8px}
}
@media(max-width:1023.98px){
  .jz-nav{border:0;min-height:0}
  .jz-nav>.container{padding:0}
  .jz-nav .jz-live,.jz-nav .main-menu-skel{display:none}
}

/* ---- تابلت / موبايل ---- */
@media(min-width:701px) and (max-width:1000px){
  .jz-t{display:none}
  .jz-ac{gap:12px}
  .jz-row{gap:14px}
}
@media(max-width:700px){
  .jz-top__a{display:none}
  .jz-top .container{justify-content:space-between;flex-wrap:nowrap;gap:8px}
  .jz-top__b{flex:1;min-width:0;line-height:1.5;font-size:11px}
  .jz-row{flex-wrap:wrap;gap:12px;padding:10px 0}
  .jz-logo{font-size:22px}
  .jz-ac{gap:14px}
  .jz-t{display:none}
  .jz-cart{padding:6px 10px!important}
  .jz-cart .s-cart-summary-total{display:none}
  .jz-sr{order:5;flex:1 0 100%;max-width:100%;width:100%}
}
@media(max-width:380px){
  .jz-row{gap:8px}
  .jz-header .jz-logo__name{display:none}
  .jz-ac{flex:none;gap:10px}
}

/* ---- الفوتر ---- */
.jz-footer{background:#fff;border-top:1px solid var(--jz-bd);font-size:13px;color:var(--jz-tx);margin-top:2rem;padding-bottom:20px}
.jz-footer__grid{display:grid;grid-template-columns:1.3fr 1fr 1fr 1fr;gap:30px;padding-top:50px}
.jz-footer h3{font-size:18px;margin-bottom:12px;color:var(--jz-br);font-weight:700}
.jz-footer p,.jz-footer__text{color:var(--jz-mt)}
.jz-footer .jz-logo img{width:60px;height:60px;object-fit:contain}
.jz-footer__about .jz-logo{margin-bottom:10px}
.jz-footer__badges{display:flex;gap:16px;align-items:flex-end;margin-top:14px}
.jz-footer__contact p{display:flex;gap:8px;align-items:flex-start;margin-bottom:6px}
.jz-footer__contact p i{color:var(--jz-gd);width:16px;text-align:center;margin-top:5px;flex:none}
.jz-footer a{transition:.2s}
.jz-footer salla-menu ul{list-style:none;margin:0;padding:0}
.jz-footer salla-menu li{margin-bottom:6px}
.jz-footer salla-menu a{color:var(--jz-mt)}
.jz-footer salla-menu a:hover{color:var(--jz-br)}
.jz-so ul{display:flex;gap:10px;margin:0;padding:0;list-style:none}
.jz-so li a,.jz-so .social-link{width:38px;height:38px;border:1px solid var(--jz-bd);border-radius:8px;display:grid;place-items:center;color:var(--jz-br);transition:.25s var(--jz-ease)}
.jz-so li a:hover{transform:translateY(-3px);color:var(--jz-gd);background:#fff}
.jz-cp{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;border-top:1px solid var(--jz-bd);margin-top:30px;padding-top:16px;color:var(--jz-mt)}
.jz-footer .copyright-text p{color:var(--jz-mt)}
@media(max-width:900px){.jz-footer__grid{grid-template-columns:1fr 1fr}}
@media(max-width:700px){
  .jz-footer__grid{grid-template-columns:1fr}
  .jz-cp{flex-direction:column;text-align:center;justify-content:center}
}
/* ============ /Jazana CSS ============ */
    </style>
    {# tracking services, custom css feature. #}
    {% hook 'head:end' %}
</head>
<body id="app" class="theme-raed overflow-x-hidden {% hook 'body:classes' %}
  {{ theme.settings.get('footer_is_dark') ? ' footer-is-dark' : ' footer-is-light' }}
  {{ theme.settings.get('topnav_is_dark') ? ' topnav-is-dark' : '' }}
  {{ theme.settings.get('sticky_add_to_cart') ? ' is-sticky-product-bar' : '' }}
  ">
<noscript>
    To get full functionality of this site you need to enable JavaScript. Here is how
    <a href="https://www.enable-javascript.com/" rel="noreferrer"
       target="_blank">To enable JavaScript on webpage</a>.
</noscript>
<div class="app-inner flex flex-col min-h-full">
    {% hook 'body:start' %}
    {% component 'header.header' %}
    <main id="main-content" role="main"{{ (page.slug == 'product.single' or page.slug starts with 'product.index') ? ' class="flex flex-col space-y-8 sm:space-y-16"' : '' }}>
    {% block content %}{% endblock %}
    </main>
    {% component 'footer.footer' %}
</div>
{% hook 'body:end' %}
{% if theme.settings.get('enable_add_product_toast', true) %}
    <salla-add-product-toast data-testid="store-add-product-toast"></salla-add-product-toast>
{% endif %}
<script defer crossorigin="anonymous" src="{{ 'app.js' | asset }}"></script>

{# Twilight Components #}
<salla-offer-modal data-testid="store-offer-modal"></salla-offer-modal>
<salla-search data-testid="store-search-modal"></salla-search>
<salla-login-modal data-testid="store-login-modal"></salla-login-modal>
{% if store.scope %}
    <salla-scopes data-testid="store-scopes" selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
{% endif %}
{% block scripts %}{% endblock %}
</body>
</html>
