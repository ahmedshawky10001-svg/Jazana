{#
  هيدر جازانة - مبني فوق هيكل ثيم Raed الأصلي
  (نفس مكونات سلة: البحث، الحساب، السلة، القائمة، القائمة الجانبية في الموبايل)

  لتعديل النصوص الثابتة غيّر المتغيرات اللي تحت.
  الستايل كله موجود في layouts/master.twig (قسم Jazana CSS).
#}
{% set jz_brand = 'مصنع جازانة للزيوت الطبيعية' %}
{% set jz_phone = '+966 53 984 9430' %}
{% set jz_phone_href = '+966539849430' %}
{% set jz_promo = 'شحن مجاني للطلبات فوق 200 ريال | زيت سمسم بلدي طبيعي' %}
{% set jz_live = 'المعصرة تعمل حاليا | شحن فوري لجميع المناطق' %}

<header data-testid="store-header" class="store-header jz-header">
  <div class="lg:hidden">
    <salla-bullet-delivery-tag></salla-bullet-delivery-tag>
  </div>

  {# ===== الشريط العلوي ===== #}
  <div class="top-navbar jz-top">
    <div class="container">
      <span class="jz-top__a">
        <b>{{ jz_brand }}</b> |
        <i class="fa-solid fa-phone"></i>
        <a href="tel:{{ jz_phone_href }}" dir="ltr">{{ jz_phone }}</a>
      </span>
      <span class="jz-top__b">
        <i class="fa-solid fa-leaf"></i>
        <span>{{ jz_promo }}</span>
      </span>
      <div class="header-buttons jz-top__c">
        {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
          <salla-localization-modal data-testid="store-header-localization" show-trigger></salla-localization-modal>
        {% endif %}
        {% if store.scope %}
          <button class="btn--rounded-gray"
                  onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
            <i class="sicon-location rtl:ml-1 ltr:mr-1"></i> {{ store.scope.name }}
          </button>
        {% endif %}
      </div>
    </div>
  </div>

  {# ===== الصف الرئيسي: لوجو + بحث + أزرار ===== #}
  <div id="mainnav" class="main-nav-container jz-main bg-white flex items-center">
    <div class="inner bg-inherit w-full">
      <div class="container">
        <div class="jz-row relative">
          <a data-testid="store-header-mobile-toggle" class="lg:hidden mburger mburger--collapse jz-mb leading-none" href="#mobile-menu" aria-label="Open-menu">
            <i class="fa-solid fa-bars"></i>
          </a>

          <a data-testid="store-header-logo" class="navbar-brand jz-logo" href="{{ store.url }}">
            <img fetchpriority="high" width="52" height="52" loading="eager" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }} logo">
            <span class="jz-logo__name">{{ store.name }}</span>
            {% if is_page('index') %}
              <h1 class="sr-only">{{ store.name }}</h1>
            {% else %}
              <h2 class="sr-only">{{ store.name }}</h2>
            {% endif %}
          </a>

          <div class="jz-sr">
            <salla-search data-testid="store-header-search" inline height="40"></salla-search>
          </div>

          <div class="jz-ac">
            <a class="jz-it" href="{{ link('customer/wishlist') }}">
              <i class="fa-regular fa-heart"></i><span class="jz-t">المفضلة</span>
            </a>
            <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger></salla-user-menu>
            <salla-cart-summary data-testid="store-header-cart" class="jz-cart">
              <i slot="icon" class="header-btn__icon icon fa-solid fa-bag-shopping"></i>
            </salla-cart-summary>
          </div>
        </div>
      </div>
    </div>
  </div>

  {# ===== شريط القائمة (القائمة الجانبية في الموبايل بتتولد من نفس المكون) ===== #}
  <div class="jz-nav">
    <div class="container">
      <div class="flex items-center jz-nav__row">
        <custom-main-menu></custom-main-menu>
      </div>
      <small class="jz-live">{{ jz_live }}</small>
    </div>
  </div>
</header>
