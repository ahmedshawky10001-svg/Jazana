{#
  فوتر جازانة - نفس مكونات Raed (القائمة، السوشيال، الدفع، الضريبة) بتصميم جازانة.
  الستايل في layouts/master.twig (قسم Jazana CSS).
#}
<footer data-testid="store-footer" class="jz-footer">
  <div class="container">
    <div class="jz-footer__grid">

      {# --- عن المتجر --- #}
      <div class="jz-footer__about">
        <a class="jz-logo" href="{{ link('/') }}">
          <img width="60" height="60" loading="lazy" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }}">
          <span class="jz-logo__name">{{ store.name }}</span>
        </a>
        {% if store.description %}
          <div class="jz-footer__text">{{ store.description|raw }}</div>
        {% else %}
          <p>متجر جازانة متخصص في إنتاج وتوفير زيت السمسم البلدي الطبيعي، بجودة عالية وطعم أصيل من قلب جازان.</p>
        {% endif %}

        <div class="jz-footer__badges">
          <salla-trust-badges data-testid="store-footer-trust-badges"></salla-trust-badges>
          {% if store.settings.tax.number %}
            <div class="flex rtl:space-x-reverse space-x-2 items-end">
              {% if store.settings.tax.certificate %}
                <a class="load-img-onclick" data-modal-id="modal-value-tax" href="#/" alt="{{ store.settings.tax.number }}">
                  <img width="40" height="50" src="{{ 'images/tax.png' | cdn(70,70) }}" loading="lazy" class="w-10 rounded-sm" alt="value added tax">
                </a>
              {% endif %}
              <div>
                <p class="text-sm mb-1">{{ trans('common.elements.tax_number') }}</p>
                <b class="text-sm">{{ store.settings.tax.number }}</b>
              </div>
            </div>
            {% if store.settings.tax.certificate %}
              <salla-modal data-testid="store-footer-tax-modal" sub-title-first sub-title="{{ trans('common.elements.tax_number') }}" modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
                <div class="flex justify-center max-w-full">
                  <img class="w-full" loading="lazy" data-src="{{ store.settings.tax.certificate }}" alt="{{ store.settings.tax.number }}"/>
                </div>
              </salla-modal>
            {% endif %}
          {% endif %}
        </div>
      </div>

      {# --- روابط مهمة (من قائمة الفوتر في لوحة سلة) --- #}
      <div>
        <h3>روابط مهمة</h3>
        <salla-menu data-testid="store-footer-menu" source="footer" with-cookie-preferences></salla-menu>
      </div>

      {# --- خدمة العملاء --- #}
      <div class="jz-footer__contact">
        <h3>خدمة العملاء</h3>
        <p><i class="fa-regular fa-clock"></i><span>فريقنا متواجد لخدمتكم يوميا من الساعة 9 صباحا حتى 10 مساء</span></p>
        <p><i class="fa-solid fa-phone"></i><a href="tel:+966539849430" dir="ltr">+966 53 984 9430</a></p>
        <p><i class="fa-regular fa-envelope"></i><a href="mailto:info@jazanaa.com">info@jazanaa.com</a></p>
        <p><i class="fa-solid fa-location-dot"></i><span>جازان - المملكة العربية السعودية</span></p>
      </div>

      {# --- السوشيال --- #}
      <div>
        <h3>تابعنا على المنصات</h3>
        <div class="jz-so">
          <salla-social data-testid="store-footer-social"></salla-social>
        </div>
      </div>

    </div>

    <div class="jz-cp">
      <span class="copyright-text">{% hook copyright %}</span>
      <salla-payments data-testid="store-footer-payments"></salla-payments>
    </div>
  </div>
</footer>
